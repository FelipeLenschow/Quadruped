# Robot image with the GPU, for JetPack 7 (Ubuntu 24.04, CUDA 13): the same image on the Jetson AGX Thor
# and on the Orin. Docker/Dockerfile stays the laptop/VDI image.
#
# The base is NVIDIA's PyTorch container (CUDA torch, torchvision and TensorRT for SBSA arm64, Python 3.12).
# Ubuntu 24.04 has ROS 2 Jazzy as apt packages, so nothing is built from source.
# A newer tag: --build-arg BASE=nvcr.io/nvidia/pytorch:<yy.mm>-py3 (a CUDA 13 one; the robot's driver must
# be at least as new as the container's CUDA).
ARG BASE=nvcr.io/nvidia/pytorch:25.08-py3
FROM ${BASE}

LABEL org.opencontainers.image.source=https://github.com/FelipeLenschow/Quadruped

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# 1. The base's CUDA torch, torchvision and numpy must never be replaced by pip's wheels: every pip install
#    below (and ultralytics' own installs at runtime) is held to them. The arch list must cover the Thor
#    (sm_110) and the Orin (sm_87; sm_80 code also runs on it).
RUN python3 -c "import torch, torchvision, numpy; \
print(f'torch=={torch.__version__}\ntorchvision=={torchvision.__version__}\nnumpy=={numpy.__version__}')" \
    > /opt/pip-constraints.txt && \
    cat /opt/pip-constraints.txt && \
    python3 -c "import torch; a = torch._C._cuda_getArchFlags(); print('CUDA archs:', a); \
import sys; sys.exit(0 if 'sm_110' in a and any(f'sm_8{i}' in a for i in '07') else \
'torch in the base lacks sm_110 (Thor) or sm_80/sm_87 (Orin): pick another BASE')"
ENV PIP_CONSTRAINT=/opt/pip-constraints.txt
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# 2. ROS 2 Jazzy: what the robot runs. Nav2 (only what nav.launch.py starts), slam_toolbox,
#    pointcloud_to_laserscan, twist_mux, joy, teleop_twist_joy, the MCAP bag plugin and pcl_ros (Point-LIO),
#    plus the build tools for src/ (Eigen and yaml-cpp: quadruped_control / quadruped_real).
#    Laptop-only tools (rviz, foxglove_bridge, plotjuggler, Gazebo) are left out.
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg lsb-release software-properties-common && \
    add-apt-repository -y universe && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-base \
    ros-jazzy-rmw-fastrtps-cpp \
    ros-jazzy-nav2-amcl ros-jazzy-nav2-behaviors ros-jazzy-nav2-bt-navigator ros-jazzy-nav2-controller \
    ros-jazzy-nav2-costmap-2d ros-jazzy-nav2-lifecycle-manager ros-jazzy-nav2-map-server \
    ros-jazzy-nav2-mppi-controller ros-jazzy-nav2-navfn-planner ros-jazzy-nav2-planner \
    ros-jazzy-slam-toolbox \
    ros-jazzy-pointcloud-to-laserscan \
    ros-jazzy-twist-mux \
    ros-jazzy-joy \
    ros-jazzy-teleop-twist-joy \
    ros-jazzy-rosbag2-storage-mcap \
    ros-jazzy-pcl-ros \
    ros-jazzy-pcl-conversions \
    python3-colcon-common-extensions \
    python3-rosdep \
    git wget libjpeg-dev libpng-dev zlib1g-dev libeigen3-dev libyaml-cpp-dev && \
    rm -rf /var/lib/apt/lists/*

# 2.5 PCL's OpenMPI brings Ubuntu's UCX, which ldconfig ranks before the base's HPC-X: torch then loads HPC-X's
#     libucc against Ubuntu's libucs and fails (undefined symbol ucs_config_doc_nop). HPC-X goes first.
RUN mv /etc/ld.so.conf.d/hpcx.conf /etc/ld.so.conf.d/00-hpcx.conf && ldconfig && \
    python3 -c "import torch; print('torch', torch.__version__)"

# 3. TensorRT's Python bindings (for exporting YOLO engines), when the base did not bring them. Checked without
#    importing: the GPU driver libraries are only there once `--runtime nvidia` mounts the robot's.
RUN FIND='import importlib.util as u, sys; sys.exit(u.find_spec("tensorrt") is None)'; \
    python3 -c "$FIND" || (pip3 install --no-cache-dir tensorrt-cu13 && python3 -c "$FIND")

# 4. Python packages, the same list as the laptop image, into the system Python 3.12 (no venv: the base's torch
#    and ROS's rclpy are both there). cv2 is pip's headless build, as on the laptop. CLIP: a prompted YOLOE
#    (detector classes:) tokenizes them with it; ultralytics installs it itself only when online.
RUN pip3 install --no-cache-dir \
    pyyaml \
    scipy \
    mujoco \
    onnxruntime \
    skrl \
    tensorboard \
    mcap \
    mcap-ros2-support \
    ultralytics==8.4.175 \
    "git+https://github.com/ultralytics/CLIP.git" \
    onnxslim && \
    (pip3 uninstall -y opencv-python opencv || true) && \
    rm -rf "$(pip3 show ultralytics | sed -n 's/^Location: //p')/cv2" && \
    pip3 install --no-cache-dir opencv-python-headless && \
    python3 -c "import clip, cv2, torch, torchvision, ultralytics; print(cv2.__version__, torch.__version__, ultralytics.__version__)"

# 5. Environment: Fast DDS like the laptop image (Tools/ros_env.sh's discovery server)
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV ROS_DOMAIN_ID=1
ENV ROS_LOCALHOST_ONLY=0
ENV PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
# OpenBLAS spins a thread per core between numpy's products (object_mapper: 144% of a core, 5% with one thread)
ENV OPENBLAS_NUM_THREADS=1
# nvidia-smi (system_monitor's GPU load on JetPack 7) needs the utility capability
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

RUN printf '#!/bin/bash\nsource /opt/ros/jazzy/setup.bash\nexec "$@"\n' > /ros_entrypoint.sh && \
    chmod +x /ros_entrypoint.sh

WORKDIR /app
RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc && \
    echo '[ -f /app/Tools/ros_env.sh ] && source /app/Tools/ros_env.sh' >> ~/.bashrc && \
    echo 'export PS1="(Quadruped-Docker-GPU) \[\033[01;32m\]\u@docker\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]# "' >> ~/.bashrc

# The repo is mounted from the host and owned by another user: let git work on it as root
RUN git config --global --add safe.directory '*'

# Up-arrow in a fresh container gives the usual start command
RUN echo 'clear && python3 launcher.py' >> ~/.bash_history

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
