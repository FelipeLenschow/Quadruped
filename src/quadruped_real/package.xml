<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quadruped_real</name>
  <version>0.1.0</version>
  <description>C++ driver for the real Go2: the control loop alone on its CPU core, ROS on the others.</description>
  <maintainer email="felipe10lenschow@gmail.com">Felipe Lenschow</maintainer>
  <license>TODO: License declaration</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_cpp</depend>
  <depend>quadruped_control</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>quadruped_bringup</exec_depend>
  <exec_depend>quadruped_description</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
