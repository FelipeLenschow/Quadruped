<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quadruped_control</name>
  <version>0.1.0</version>
  <description>C++ control core (kinematics, state estimator) shared by every backend, with Python bindings.</description>
  <maintainer email="felipe10lenschow@gmail.com">Felipe Lenschow</maintainer>
  <license>TODO: License declaration</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>quadruped_description</exec_depend>
  <test_depend>quadruped_core</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
