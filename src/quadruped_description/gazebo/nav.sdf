        <include>
            <uri>model://traffic_cone</uri>
            <name>cone_1</name>
            <pose>4.5 0.0 0 0 0 0</pose>
        </include>
        <include>
            <uri>model://traffic_cone</uri>
            <name>cone_2</name>
            <pose>6.5 3.8 0 0 0 0</pose>
        </include>
        <include>
            <uri>model://traffic_cone</uri>
            <name>cone_3</name>
