                <visual name="visual">
                    <geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
                    <material><ambient>0.7 0.15 0.15 1</ambient><diffuse>0.7 0.15 0.15 1</diffuse></material>
