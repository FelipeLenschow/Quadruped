        <model name="barrel_2">
            <static>true</static>
            <pose>-1.0 3.5 0.45 0 0 0</pose>
            <link name="link">
                <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry></collision>
                <visual name="visual">
                    <geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
                    <material><ambient>0.7 0.15 0.15 1</ambient><diffuse>0.7 0.15 0.15 1</diffuse></material>
